              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const list = Array.isArray(b) ? b : (b.data && b.data.items) || b.data || b.items || [];",
                  "pm.test(\"hay al menos un plan\", () => pm.expect(list.length).to.be.above(0));",
                  "pm.collectionVariables.set(\"planId\", list[0].id || list[0].mealPlanId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{gateway}}/api/catalog/v1/meal-plans",
              "host": [
