    {
      "name": "2. Contrato y pago (MS3 -> MS4 por REST)",
      "item": [
        {
          "name": "2.1 Crear contrato",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"contractId\", pm.response.json().id);",
                  "pm.test(\"PendingPayment\", () => pm.expect(pm.response.json().status).to.eql(\"PendingPayment\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{gateway}}/api/contracting/v1/contracts",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "contracting",
                "v1",
                "contracts"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"00000000-0000-0000-0000-000000000001\",\n  \"catalogPlanId\": \"{{planId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.2 Pagar el contrato",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 processed\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql(\"processed\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{gateway}}/api/contracting/v1/billing/charge-plan",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "contracting",
                "v1",
                "billing",
                "charge-plan"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contractId\": \"{{contractId}}\",\n  \"amount\": 550,\n  \"invoiceNumber\": \"inv-{{$randomInt}}-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Responde al instante. La llamada a MS4 NO ocurre aqui: queda en una fila del outbox y la hace el worker."
          }
        },
        {
          "name": "2.3 Fila del outbox (espera hasta que MS4 acepte)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const contractId = pm.collectionVariables.get(\"contractId\");",
                  "const url = pm.collectionVariables.get(\"gateway\") + \"/api/contracting/v1/sim/outgoing/CreateSchedule\";",
                  "function poll(n) {",
                  "  pm.sendRequest(url, (err, res) => {",
                  "    const row = !err && res.json().find(e => e.payload.includes(contractId));",
                  "    if ((row && row.status !== \"Simulated\") || n >= 40) return;",
                  "    setTimeout(() => poll(n + 1), 1000);",
                  "  });",
                  "}",
                  "poll(0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const row = pm.response.json().find(e => e.payload.includes(pm.collectionVariables.get(\"contractId\")));",
                  "pm.test(\"existe la fila del contrato\", () => pm.expect(row).to.exist);",
                  "console.log(\"Estado de la fila:\", row && row.status);",
                  "pm.test(\"Published = MS4 creo el calendario (si dice Simulated, repite en unos segundos)\", () => pm.expect(row.status).to.eql(\"Published\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{gateway}}/api/contracting/v1/sim/outgoing/CreateSchedule",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "contracting",
                "v1",
                "sim",
                "outgoing",
                "CreateSchedule"
              ],
              "query": []
            },
            "description": "Simulated = pendiente. Published = MS4 acepto el calendario."
          }
        },
        {
          "name": "2.4 Calendario creado en MS4",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const contractId = pm.collectionVariables.get(\"contractId\");",
                  "const token = pm.collectionVariables.get(\"adminToken\");",
                  "const base = pm.collectionVariables.get(\"gateway\");",
                  "function probe(i) {",
                  "  if (i > 300) return;",
                  "  pm.sendRequest({ url: `${base}/api/delivery-calendar/v1/calendars/${i}`, method: \"GET\", header: { Authorization: `Bearer ${token}` } }, (err, res) => {",
                  "    if (!err && res.code === 200 && res.json().contractId === contractId) { pm.collectionVariables.set(\"calendarId\", i); } else { probe(i + 1); }",
                  "  });",
                  "}",
                  "probe(1);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"calendario de MI contrato\", () => pm.expect(pm.response.json().contractId).to.eql(pm.collectionVariables.get(\"contractId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{gateway}}/api/delivery-calendar/v1/calendars/{{calendarId}}",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "delivery-calendar",
                "v1",
                "calendars",
                "{{calendarId}}"
              ],
              "query": []
            },
            "description": "Antes de pedirlo busca el calendario por contractId. Alternativa: psql contra ms4_delivery_calendar (ver guion)."
          }
        }
      ]
    },
