                  "function poll(n) {",
                  "  pm.sendRequest(url, (err, res) => {",
                  "    const row = !err && res.json().find(e => e.payload.includes(pkg));",
                  "    if ((row && row.status !== \"Simulated\") || n >= 30) return;",
