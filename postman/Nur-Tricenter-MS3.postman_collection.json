                  "const dayId = String(pm.variables.get(\"dayId\"));",
                  "const token = pm.variables.get(\"adminToken\");",
                  "function poll(n) {",
                  "  pm.sendRequest({ url: `${base}/api/delivery-calendar/v1/calendars/${cal}`, header: { Authorization: `Bearer ${token}` } }, (err, res) => {",
